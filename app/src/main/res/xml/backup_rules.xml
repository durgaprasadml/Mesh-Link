<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup exclusion rules for Mesh Link.

    These files are INTENTIONALLY excluded from Android Backup because they are encrypted
    with hardware-backed Android Keystore keys. Backed-up copies of these files cannot be
    decrypted on a different device (or after a factory reset) because the Keystore master
    key is hardware-bound and non-exportable.

    Restoring these files on a new device would cause silent decryption failures in
    EncryptedSharedPreferences and SQLCipher, breaking the entire security subsystem.
-->
<full-backup-content>
    <!-- Database passphrase config (legacy plaintext) -->
    <exclude domain="sharedpref" path="mesh_db_config.xml" />
    <!-- Database passphrase config (encrypted) — Keystore-bound, non-transferable -->
    <exclude domain="sharedpref" path="mesh_db_config_enc.xml" />
    <!-- Peer ECDH public keys — Keystore-wrapped, unreadable on restore to new device -->
    <exclude domain="sharedpref" path="mesh_peer_keys.xml" />
    <!-- Peer ECDSA signing keys — Keystore-wrapped, unreadable on restore to new device -->
    <exclude domain="sharedpref" path="mesh_peer_signing_keys.xml" />
    <!-- Broadcast group symmetric keys — Keystore-wrapped, non-transferable -->
    <exclude domain="sharedpref" path="mesh_broadcast_keys.xml" />
    <!-- SQLCipher encrypted database — decryption key is Keystore-bound, unreadable on restore -->
    <exclude domain="database" path="mesh_db" />
</full-backup-content>
